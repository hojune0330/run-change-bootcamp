# Public browser configuration only. Preview remains the safe default.
VITE_APP_RUNTIME=preview

# Dev-only agent tooling (react-grab agent context copy + react-scan rendering
# diagnostics). Off by default: react-grab injects a full-screen overlay that
# blocks the shell's bottom navigation clicks. Enable explicitly when needed.
# VITE_ENABLE_DEV_TOOLS=1

# Pilot mode requires both values below. Prefer a Supabase publishable key.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
